# Copy to .env and adjust. Values here are safe placeholders / public defaults.
# Already-set environment variables win over .env.

# --- server ---
PORT=3000
# Directory for listings.json, users.json, and the generated session secret.
# DATA_DIR=./data

# --- harvest ---
# Comma-separated Airbnb city slugs (City--ST).
CITIES=San-Francisco--CA,Oakland--CA,Daly-City--CA,New-York--NY
# Disjoint $/month search bands. Trailing dash = open top.
PRICE_BANDS=0-1100,1100-1600,1600-2400,2400-3500,3500-5200,5200-
# Optional global max $/month; 0 = disabled.
MAX_PRICE=0
WINDOW_DAYS=48
MIN_RUNWAY=28
CAL_TTL_HOURS=6
SEARCH_TTL_HOURS=3
# Refreshes every city automatically; catches up after restarts.
REFRESH_HOURS=24
REFRESH_RETRY_HOURS=1
# Set to 1 to pause every automatic/manual harvest.
# HARVEST_DISABLED=1
# Public read-only deployment; writes require a bearer token.
# HOSTED=1
# HARVEST_TOKEN=generate-a-long-random-token

# --- free AI (optional) ---
# Only openrouter/free is used. Paid models cannot be selected.
# Without this, the location/budget finder still works with local parsing.
# OPENROUTER_API_KEY=

# Public Airbnb web-client key + GraphQL persisted-query hash (embedded in
# airbnb.com; not personal credentials). Override if Airbnb rotates them.
# AIRBNB_API_KEY=
# CAL_HASH=

# --- sessions ---
# HMAC cookie secret. If unset, a random secret is written to DATA_DIR/session.secret.
# SESSION_SECRET=replace-with-a-long-random-string
# Secure cookies when FLY_APP_NAME is set or NODE_ENV=production.
# NODE_ENV=development
# ALLOW_GUEST=1

# --- OAuth (optional; guest login is shown until any provider is configured) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
